{
    "name": "event-manager",
    "version": "1.0.0",
    "engines": {
      "node": ">=20.0.0",
      "npm": ">=9.0.0"
    },
    "scripts": {
      "build": "nest build",
      "start": "node dist/main.js",
      "start:dev": "nest start --watch",
      "start:debug": "nest start --debug --watch",
      "format": "prettier --write \"src/**/*.ts\"",
      "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
      "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
      "test": "jest",
      "test:watch": "jest --watch",
      "test:cov": "jest --coverage",
      "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
      "test:e2e": "jest --config ./test/jest-e2e.json",
      "typeorm": "typeorm-ts-node-commonjs",
      "migration:generate": "npm run typeorm migration:generate -- -d typeorm.config.js",
      "migration:create": "npm run typeorm migration:create",
      "migration:run": "npm run typeorm migration:run -- -d typeorm.config.js",
      "migration:revert": "npm run typeorm migration:revert -- -d typeorm.config.js",
      "migration:show": "npm run typeorm migration:show -- -d typeorm.config.js"
    },
    "dependencies": {
      "@nestjs/common": "^11.0.9",
      "@nestjs/core": "^11.0.9",
      "@nestjs/platform-express": "^11.0.9",
      "@nestjs/typeorm": "^11.0.0",
      "@nestjs/config": "^4.0.0",
      "class-validator": "^0.14.1",
      "class-transformer": "^0.5.1",
      "pg": "^8.13.3",
      "typeorm": "^0.3.20",
      "reflect-metadata": "^0.2.2",
      "rxjs": "^7.8.1",
      "zod": "^3.24.2",
      "uuid": "^11.0.5"
    },
    "devDependencies": {
      "@nestjs/cli": "^11.0.2",
      "@types/node": "^22.13.2",
      "@types/uuid": "^10.0.0",
      "typescript": "^5.7.3",
      "ts-node": "^10.9.2",
      "ts-loader": "^9.5.2",
      "@typescript-eslint/eslint-plugin": "^8.24.0",
      "@typescript-eslint/parser": "^8.24.0",
      "eslint": "^9.20.1",
      "eslint-config-prettier": "^10.0.1",
      "eslint-plugin-prettier": "^5.2.3",
      "prettier": "^3.5.1",
      "@nestjs/testing": "^11.0.9",
      "@types/jest": "^29.5.14",
      "@types/supertest": "^6.0.2",
      "jest": "^29.7.0",
      "supertest": "^7.0.0",
      "ts-jest": "^29.2.5"
    }
  }